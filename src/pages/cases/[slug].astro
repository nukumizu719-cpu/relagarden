---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets'; // 追加：画像最適化用

export async function getStaticPaths() {
  const entries = await getCollection('cases');
  return entries.map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();

// SEO対策
// 記事のタイトルに【地域】が入っているものと、入っていないものがある。
// 入っているものへ重ねて付けると【岡崎市】【岡崎市】…になるので分ける。
const headline = entry.data.title.startsWith('【')
  ? entry.data.title
  : `【${entry.data.area}】${entry.data.title}`;
const pageTitle = `${headline} | 人工芝施工事例`;

// 施工前の悩みと費用は任意項目。無い記事で「undefined」を出さない。
const concernSummary = entry.data.beforeConcerns?.slice(0, 80);
const description = [
  `${entry.data.area}での人工芝施工事例。`,
  concernSummary ? `${concernSummary}... ` : '',
  entry.data.cost ? `施工費用の目安：${entry.data.cost}` : '',
].join('');

// JSON-LD（画像URLを文字列として抽出するために .src を使用）
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": description,
  "image": [entry.data.image.src], // .src を追加してURL文字列に変換
  "author": {
    "@type": "Organization",
    "name": "リラガーデン"
  },
  "areaServed": {
    "@type": "City",
    "name": entry.data.area
  }
};
---

<BaseLayout exactTitle={pageTitle} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="bg-white pb-20" itemscope itemtype="https://schema.org/Service">
    <div class="max-w-4xl mx-auto px-4 pt-12">
      <nav class="flex text-xs text-gray-400 mb-6 gap-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-green-700 transition-colors">TOP</a>
        <span>/</span>
        <a href="/cases/" class="hover:text-green-700 transition-colors">施工事例一覧</a>
        <span>/</span>
        <span class="text-gray-600" aria-current="page">{entry.data.area}の事例</span>
      </nav>
      
      <header class="mb-10 border-b pb-6">
        <h1 class="text-2xl md:text-4xl font-bold font-zen leading-tight text-gray-900">
          <span class="block text-sm text-green-700 mb-2 font-bold tracking-widest uppercase">施工事例 / {entry.data.area}</span>
          {entry.data.title}
        </h1>
        <div class="flex gap-4 mt-6">
          <div class="bg-gray-50 px-4 py-2 rounded-lg">
            <p class="text-[10px] text-gray-400 uppercase font-bold">Cost</p>
            <p class="text-sm font-bold text-gray-700">{entry.data.cost}</p>
          </div>
          <div class="bg-gray-50 px-4 py-2 rounded-lg">
            <p class="text-[10px] text-gray-400 uppercase font-bold">Period</p>
            <p class="text-sm font-bold text-gray-700">{entry.data.period}</p>
          </div>
        </div>
      </header>

      {/* 画像セクション：Imageコンポーネントに差し替え */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        {entry.data.beforeImage && (
          <div class="space-y-3">
            <div class="relative aspect-[4/3] rounded-2xl overflow-hidden shadow-sm border border-gray-100 bg-gray-50 group">
              <span class="absolute top-4 left-4 bg-gray-800/80 backdrop-blur-sm text-white px-3 py-1 text-[10px] font-bold tracking-widest rounded z-10">BEFORE</span>
              <Image 
                src={entry.data.beforeImage} 
                width={800} 
                height={600} 
                format="avif"
                class="w-full h-full object-cover grayscale-[0.2] transition-transform duration-500 group-hover:scale-105" 
                alt={`${entry.data.area}の人工芝施工前の庭の様子`} 
              />
            </div>
            <p class="text-center text-xs text-gray-400 italic font-medium">施工前のお悩みのお庭</p>
          </div>
        )}
        <div class="space-y-3">
          <div class="relative aspect-[4/3] rounded-2xl overflow-hidden shadow-xl border-4 border-green-50 group">
            <span class="absolute top-4 left-4 bg-green-700 text-white px-3 py-1 text-[10px] font-bold tracking-widest rounded z-10">AFTER</span>
            <Image 
              src={entry.data.image} 
              width={800} 
              height={600} 
              format="avif"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
              alt={`${entry.data.area}で人工芝を施工した後の美しい庭`} 
            />
          </div>
          <p class="text-center text-xs text-green-700 font-bold font-zen">施工後の理想のお庭</p>
        </div>
      </div>

      {/* 以降のコンテンツ部分は変更なし */}
      <div class="space-y-12 mb-20">
        {entry.data.beforeConcerns && (
          <section class="relative max-w-2xl mx-auto transform -rotate-1" aria-label="施工前のお悩み">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-8 h-8 bg-blue-400 rounded-full shadow-inner z-20 opacity-80"></div>
            <div class="bg-[#f0f4f8] p-8 md:p-10 shadow-lg border-b-4 border-blue-100 rounded-sm">
              <h3 class="text-lg font-bold text-blue-900 mb-4 flex items-center gap-2 font-zen">
                <span class="text-xl">😟</span> 施工前の悩み
              </h3>
              <p class="text-blue-900/80 leading-relaxed font-medium italic">{entry.data.beforeConcerns}</p>
            </div>
          </section>
        )}

        {entry.data.customerVoice && (
          <section class="relative max-w-2xl mx-auto transform rotate-1" aria-label="お客様の声">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-8 h-8 bg-red-500 rounded-full shadow-inner z-20 opacity-80"></div>
            <div class="bg-[#ffffa0] p-8 md:p-10 shadow-lg border-b-4 border-yellow-200 rounded-sm">
              <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2 font-zen">
                <span class="text-xl">😊</span> 施工完了：お客様の声
              </h3>
              <p class="text-gray-800 leading-relaxed font-bold italic text-lg md:text-xl">{entry.data.customerVoice}</p>
            </div>
          </section>
        )}
      </div>

      {entry.data.constructionPoints && entry.data.constructionPoints.length > 0 && (
        <section class="mb-20" aria-label="施工のポイント">
          <h2 class="text-center text-xl font-bold font-zen text-gray-800 mb-8 flex items-center justify-center gap-4">
            <span class="w-8 h-px bg-green-200"></span>
            プロのこだわり
            <span class="w-8 h-px bg-green-200"></span>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {entry.data.constructionPoints.map((point) => (
              <div class="bg-white border-t-4 border-green-700 p-6 shadow-md rounded-xl hover:-translate-y-1 transition-transform">
                <div class="bg-green-50 w-8 h-8 rounded-full flex items-center justify-center text-green-700 font-bold mb-4 text-xs">✓</div>
                <p class="text-[13px] md:text-sm text-gray-700 leading-relaxed font-bold">{point}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <div class="prose prose-lg max-w-none prose-green pt-16 border-t border-gray-100
        prose-h2:text-2xl prose-h2:font-zen prose-h2:text-gray-800 prose-h2:border-l-4 prose-h2:border-green-700 prose-h2:pl-4
        prose-strong:text-green-900">
        <Content />
      </div>

      <div class="mt-20 p-8 md:p-12 bg-green-900 rounded-[40px] text-center text-white shadow-2xl relative overflow-hidden">
        <div class="relative z-10">
          <h2 class="text-xl md:text-2xl font-bold font-zen mb-4">あなたのお庭も、<br class="md:hidden" />劇的に変えませんか？</h2>
          <p class="text-green-100 mb-8 text-xs md:text-sm opacity-90 leading-relaxed">
            {entry.data.area}周辺の現地調査・お見積もりは無料です。<br class="md:hidden" />
            まずはお気軽にご相談ください。
          </p>
          <div class="flex flex-col md:flex-row items-center justify-center gap-4">
            <a href="/contact/" class="w-full md:w-auto inline-block bg-white text-green-900 px-12 py-4 rounded-full font-bold shadow-lg hover:bg-green-50 transition-all transform hover:scale-105">
              無料見積もり・相談
            </a>
            <a href="tel:09021334003" class="w-full md:w-auto inline-block border border-white/30 bg-white/10 backdrop-blur-sm text-white px-10 py-4 rounded-full font-bold hover:bg-white/20 transition-all">
              電話で相談する
            </a>
          </div>
        </div>
        <div class="absolute top-0 right-0 w-40 h-40 bg-green-800 rounded-full -mr-20 -mt-20 opacity-40"></div>
        <div class="absolute bottom-0 left-0 w-32 h-32 bg-green-950 rounded-full -ml-16 -mb-16 opacity-40"></div>
      </div>
    </div>
  </article>
</BaseLayout>